#!/usr/bin/env sh
if ! command -v npx >/dev/null 2>&1; then
  echo "⚠️  npx not found in PATH — skipping pre-commit hooks"
  echo "   Run 'npm run lint && npm run check:any-budget:t11' manually before pushing."
  exit 0
fi

# Fork mode toggle: strict gates are disabled by default.
# Enable explicitly via: ENABLE_STRICT_CHECKS=1 git commit ...
if [ "${ENABLE_STRICT_CHECKS:-0}" != "1" ] && [ "${STRICT_CHECKS:-0}" != "1" ]; then
  npx lint-staged || true
  exit 0
fi

# Full strict local gates (enabled when ENABLE_STRICT_CHECKS=1 or STRICT_CHECKS=1)
npx lint-staged
node scripts/check/check-docs-sync.mjs
npm run check:any-budget:t11
node scripts/check/check-tracked-artifacts.mjs
